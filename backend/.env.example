# Copy to backend/.env and fill in. Never commit .env.

# MongoDB Atlas connection string. Create a database user and paste the SRV URI.
# The database name below is appended; do not include it in the URI path.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=recallos

# Random string, at least 32 characters. Used to sign JWTs.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# Google AI Studio key (https://aistudio.google.com/apikey). Leave blank to run
# with the local hashing embedder and template responses — no billing needed.
GEMINI_API_KEY=

# Model ids. Change these here only; nothing else hardcodes them.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Retrieval ranking weights. Must sum to 1.
RANK_WEIGHT_SIMILARITY=0.50
RANK_WEIGHT_IMPORTANCE=0.20
RANK_WEIGHT_CONFIDENCE=0.15
RANK_WEIGHT_RECENCY=0.15

# How many memories are retrieved, and the minimum similarity to keep one.
RETRIEVAL_CANDIDATES=12
RETRIEVAL_MIN_SIMILARITY=0.30
RETRIEVAL_MAX_MEMORIES=5

# Atlas Vector Search index name. Must match the index you create in Atlas.
VECTOR_INDEX_NAME=memories_vector

# CORS origin for the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173
